{
  "name": "nighttune-backend",
  "author": "houthacker",
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@dotenvx/dotenvx": "^1.61.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.215.0",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.215.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/instrumentation-winston": "^0.59.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-logs": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@opentelemetry/winston-transport": "^0.25.0",
    "@tsconfig/node24": "^24.0.4",
    "arktype": "^2.1.29",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.10",
    "ejs": "^5.0.2",
    "esm": "^3.2.25",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "iron-session": "^8.0.4",
    "jwt-decode": "^4.0.0",
    "ml-savitzky-golay-generalized": "^5.0.0",
    "node-fetch": "^3.3.2",
    "node-mailjet": "^6.0.11",
    "piscina": "^5.1.4",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/dockerode": "^4.0.1",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/node-fetch": "^2.6.13",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "description": "Nighttune API backend",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "module": "main.ts",
  "keywords": [
    "nighttune",
    "autotune",
    "oref0"
  ],
  "license": "MIT",
  "bin": {
    "initdb": "scripts/initdb.sh"
  },
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "postinstall": "npm i -g oref0 @dotenvx/dotenvx",
    "postbuild": "npx copyfiles ./src/templates/*.ejs ./build",
    "initdb": "./scripts/initdb.sh",
    "start": "dotenvx run --convention=nextjs -- node build/main.js",
    "dev": "dotenvx run --convention=nextjs -- nodemon -e ts --exec node --import=tsx main.ts ",
    "test": "node --import tsx --test tests/**/*test.ts"
  },
  "type": "module",
  "version": "3.5.0"
}
